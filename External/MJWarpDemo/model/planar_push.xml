<mujoco model="planar_push">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast" solver="Newton" iterations="20" cone="pyramidal"/>
  <size njmax="128" nconmax="32"/>

  <default>
    <joint damping="1.2" armature="0.02" limited="true"/>
    <geom friction="0.9 0.01 0.0001" condim="3" contype="1" conaffinity="1"/>
    <motor ctrllimited="true" ctrlrange="-8 8"/>
  </default>

  <worldbody>
    <light name="key" pos="0 0 2" dir="0 0 -1"/>
    <geom name="table" type="plane" size="1.2 0.8 0.05" rgba="0.22 0.25 0.30 1" friction="1.1 0.02 0.001"/>

    <body name="base" pos="-0.35 0 0.06">
      <geom name="base_geom" type="cylinder" size="0.08 0.06" rgba="0.16 0.19 0.24 1" contype="0" conaffinity="0"/>
      <body name="link1" pos="0 0 0">
        <joint name="shoulder" type="hinge" axis="0 0 1" range="-2.7 2.7"/>
        <geom name="link1_geom" type="box" pos="0.16 0 0" size="0.16 0.035 0.03" rgba="0.12 0.48 0.92 1"/>
        <body name="link2" pos="0.32 0 0">
          <joint name="elbow" type="hinge" axis="0 0 1" range="-2.8 2.8"/>
          <geom name="link2_geom" type="box" pos="0.14 0 0" size="0.14 0.03 0.025" rgba="0.08 0.66 0.82 1"/>
          <body name="pusher" pos="0.28 0 0">
            <geom name="pusher_geom" type="sphere" size="0.045" rgba="1.0 0.62 0.08 1" friction="1.2 0.02 0.001"/>
          </body>
        </body>
      </body>
    </body>

    <body name="cube" pos="0.04 0 0.041">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.04 0.04 0.04" density="650" rgba="0.92 0.18 0.20 1" friction="0.85 0.02 0.001"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="shoulder_motor" joint="shoulder" gear="1"/>
    <motor name="elbow_motor" joint="elbow" gear="1"/>
  </actuator>
</mujoco>
