<mujoco model="quality_inspection">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast" solver="Newton" iterations="16" cone="pyramidal"/>
  <size njmax="96" nconmax="24"/>

  <default>
    <joint damping="1.2" armature="0.02" limited="true"/>
    <geom friction="0.9 0.01 0.0001" condim="3" contype="1" conaffinity="1"/>
    <motor ctrllimited="true" ctrlrange="-8 8"/>
  </default>

  <worldbody>
    <light name="key" pos="0 0 2" dir="0 0 -1"/>
    <geom name="inspection_table" type="plane" size="1.2 0.8 0.05" rgba="0.18 0.22 0.26 1"/>
    <geom name="station_a" type="box" pos="0.02 -0.15 0.025" size="0.055 0.055 0.025" rgba="0.16 0.72 0.50 1" contype="0" conaffinity="0"/>
    <geom name="station_b" type="cylinder" pos="0.15 0 0.025" size="0.050 0.025" rgba="0.98 0.62 0.10 1" contype="0" conaffinity="0"/>
    <geom name="station_c" type="box" pos="0.02 0.15 0.025" size="0.055 0.055 0.025" rgba="0.86 0.24 0.40 1" contype="0" conaffinity="0"/>

    <body name="base" pos="-0.35 0 0.06">
      <geom name="base_geom" type="cylinder" size="0.08 0.06" rgba="0.16 0.19 0.24 1" contype="0" conaffinity="0"/>
      <body name="link1" pos="0 0 0">
        <joint name="shoulder" type="hinge" axis="0 0 1" range="-2.7 2.7"/>
        <geom name="link1_geom" type="box" pos="0.16 0 0" size="0.16 0.035 0.03" rgba="0.08 0.62 0.68 1"/>
        <body name="link2" pos="0.32 0 0">
          <joint name="elbow" type="hinge" axis="0 0 1" range="-2.8 2.8"/>
          <geom name="link2_geom" type="box" pos="0.14 0 0" size="0.14 0.03 0.025" rgba="0.10 0.76 0.72 1"/>
          <body name="pusher" pos="0.28 0 0">
            <geom name="inspection_probe" type="sphere" size="0.032" rgba="0.96 0.96 1.0 1" contype="0" conaffinity="0"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="shoulder_motor" joint="shoulder" gear="1"/>
    <motor name="elbow_motor" joint="elbow" gear="1"/>
  </actuator>
</mujoco>
