<mujoco model="warehouse_navigation">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast" solver="Newton" iterations="20" cone="pyramidal"/>
  <size njmax="128" nconmax="48"/>

  <default>
    <joint damping="2.0" armature="0.05" limited="true"/>
    <geom friction="0.9 0.01 0.0001" condim="3" contype="1" conaffinity="1"/>
    <motor ctrllimited="true" ctrlrange="-10 10"/>
  </default>

  <worldbody>
    <light name="key" pos="0 0 2" dir="0 0 -1"/>
    <geom name="warehouse_floor" type="plane" size="1.2 0.8 0.05" rgba="0.20 0.22 0.25 1" friction="1.2 0.02 0.001"/>
    <geom name="north_wall" type="box" pos="0 0.50 0.06" size="0.68 0.025 0.06" rgba="0.30 0.34 0.40 1"/>
    <geom name="south_wall" type="box" pos="0 -0.50 0.06" size="0.68 0.025 0.06" rgba="0.30 0.34 0.40 1"/>
    <geom name="west_wall" type="box" pos="-0.68 0 0.06" size="0.025 0.50 0.06" rgba="0.30 0.34 0.40 1"/>
    <geom name="east_wall" type="box" pos="0.68 0 0.06" size="0.025 0.50 0.06" rgba="0.30 0.34 0.40 1"/>
    <geom name="north_shelf" type="box" pos="0 0.29 0.08" size="0.07 0.19 0.08" rgba="0.34 0.42 0.54 1"/>
    <geom name="south_shelf" type="box" pos="0 -0.29 0.08" size="0.07 0.19 0.08" rgba="0.34 0.42 0.54 1"/>

    <body name="mobile_base" pos="0 0 0.055">
      <joint name="drive_x" type="slide" axis="1 0 0" range="-0.58 0.58"/>
      <joint name="drive_y" type="slide" axis="0 1 0" range="-0.42 0.42"/>
      <geom name="amr_chassis" type="box" size="0.060 0.050 0.040" density="600" rgba="0.12 0.52 0.94 1" friction="1.1 0.02 0.001"/>
      <geom name="cargo" type="box" pos="0 0 0.065" size="0.038 0.035 0.025" rgba="0.94 0.48 0.12 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="drive_x_motor" joint="drive_x" gear="1"/>
    <motor name="drive_y_motor" joint="drive_y" gear="1"/>
  </actuator>
</mujoco>
